{
  "manifest_version": 3,
  "key": "",
  "name": "ChromePW",
  "version": "1.7.0",
  "description": "A small encrypted password vault synced through Chrome.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ChromePW",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
